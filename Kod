def solve_instance(filepath, use_gurobi=True):
    """Solve one APC instance with subgradient + optional Gurobi."""
    inst = load_instance(filepath)
    iid = inst["instance_id"]
    n = inst["n"]
    nc = inst["num_conflicts"]
    print(f"  {iid}  n={n}  |P|={nc}", end="  ", flush=True)

    # Subgradient
    sg = subgradient_solve(inst)
    print(f"SG: LB={sg['best_lb']:.0f} UB={sg['best_ub']:.0f} "
          f"gap={sg['gap']:.2f}% iter={sg['iterations']} "
          f"t={sg['time']:.1f}s", end="", flush=True)

    result = {
        "instance_id": iid,
        "n": n,
        "num_conflicts": nc,
        "group": inst["metadata"]["group"],
        "subgradient": {
            "lower_bound": sg["best_lb"],
            "upper_bound": sg["best_ub"],
            "gap_pct": sg["gap"],
            "assignment": sg["assignment"],
            "iterations": sg["iterations"],
            "time_sec": sg["time"],
            "feasible": sg["feasible"],
        },
    }

    # Gurobi exact
    if use_gurobi and HAS_GUROBI:
        gb = solve_exact_gurobi(inst)
        if gb and gb.get("objective") is not None:
            result["gurobi"] = gb
            print(f"  |  GRB: opt={gb['objective']:.0f} "
                  f"t={gb['time_sec']:.1f}s", end="", flush=True)

    print()
    return result


def solve_all(instances_dir, solutions_dir=None):
    """Solve all 100 instances, save individual solutions + summary CSV."""
    if solutions_dir is None:
        solutions_dir = os.path.join(os.path.dirname(instances_dir), "solutions")
    os.makedirs(solutions_dir, exist_ok=True)

    groups = ["xs", "s", "m", "l", "xl"]
    summary = []

    for grp in groups:
        grp_in = os.path.join(instances_dir, grp)
        if not os.path.isdir(grp_in):
            continue
        grp_out = os.path.join(solutions_dir, grp)
        os.makedirs(grp_out, exist_ok=True)

        files = sorted(f for f in os.listdir(grp_in) if f.endswith(".json"))
        print(f"\n{'═'*60}")
        print(f"  Group {grp.upper()}  ({len(files)} instances)")
        print(f"{'═'*60}")

        for fname in files:
            res = solve_instance(os.path.join(grp_in, fname), use_gurobi=HAS_GUROBI)

            # save individual solution
            sol_path = os.path.join(grp_out, fname.replace(".json", "_sol.json"))
            with open(sol_path, "w") as f:
                json.dump(res, f, indent=2)

            row = {
                "instance_id": res["instance_id"],
                "group": res["group"],
                "n": res["n"],
                "num_conflicts": res["num_conflicts"],
                "sg_lb": res["subgradient"]["lower_bound"],
                "sg_ub": res["subgradient"]["upper_bound"],
                "sg_gap": res["subgradient"]["gap_pct"],
                "sg_iter": res["subgradient"]["iterations"],
                "sg_time": res["subgradient"]["time_sec"],
                "sg_feasible": res["subgradient"]["feasible"],
            }
            if "gurobi" in res:
                gb = res["gurobi"]
                row["grb_optimal"] = gb.get("objective", "")
                row["grb_gap"] = gb.get("gap_pct", "")
                row["grb_time"] = gb.get("time_sec", "")
                row["grb_status"] = gb.get("status", "")
            summary.append(row)

    # ── summary CSV ──
    csv_path = os.path.join(solutions_dir, "solution_summary.csv")
    if summary:
        fields = list(summary[0].keys())
        for r in summary:
            for k in r:
                if k not in fields:
                    fields.append(k)
        with open(csv_path, "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=fields)
            w.writeheader()
            w.writerows(summary)

    print(f"\n{'═'*60}")
    print(f"  DONE — {len(summary)} instances solved")
    print(f"  Solutions : {solutions_dir}")
    print(f"  Summary   : {csv_path}")
    print(f"  Gurobi    : {'YES' if HAS_GUROBI else 'NO'}")
    print(f"{'═'*60}")
    return summary


# ═══════════════════════════════════════════════════════════════
if __name__ == "__main__":
    base = os.path.dirname(os.path.abspath(__file__))
    instances_dir = os.path.join(base, "instances")
    solve_all(instances_dir)
